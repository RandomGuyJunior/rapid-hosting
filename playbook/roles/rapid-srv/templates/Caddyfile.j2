{
	default_sni {{ domain_name }}
	metrics {
		per_host
	}
}

:2020 {
	metrics
}

{{ domain_name }} {
	# A build reports its outcome with the chunked framing, so the response
	# must not be buffered, see rapid-builder/docs/api.md.
	handle /build {
		reverse_proxy rapid-build.dns.podman:8080 {
			flush_interval -1
		}
	}

	handle {
		root * /srv/repos
		file_server
	}
}

moddedbar.duckdns.org {
	handle /find {
		reverse_proxy host.containers.internal:8301
	}
	handle /maps.json {
		reverse_proxy host.containers.internal:8301
	}
	handle /github-webhook {
		reverse_proxy host.containers.internal:8302
	}
	handle_path /maps/* {
		root * /srv/maps
		file_server
	}
}
